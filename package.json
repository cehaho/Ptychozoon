{
  "name": "ptychozoon",
  "version": "1.0.0",
  "description": "Interactive network topology viewer with SSH terminal, network discovery, and real-time monitoring",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "test": "node --test && cargo test --manifest-path src-tauri/Cargo.toml",
    "postinstall": "node scripts/copy-vendor.js",
    "build": "tauri build",
    "lint": "eslint . && prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "keywords": [
    "network",
    "topology",
    "ssh",
    "monitoring",
    "tauri"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide": "^1.77.0"
  }
}
